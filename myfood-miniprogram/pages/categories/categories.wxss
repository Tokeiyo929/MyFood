.page { padding: 0; }
.group { background: #fff; margin-bottom: 8px; }
.group-items { border-top: 1px solid #f0f0f0; }
.empty { padding: 40px 0; }
.modal-panel { padding: 16px; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.modal-title { font-size: 17px; font-weight: 700; }
.modal-foods { display: flex; flex-wrap: wrap; gap: 12px; }
.modal-food { width: 88px; text-align: center; }
.modal-food-img { width: 88px; height: 88px; border-radius: 8px; }
.modal-food-name { font-size: 12px; margin-top: 4px; display: block; }
