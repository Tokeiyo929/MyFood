<view class="page">
  <view class="card">
    <van-field label="产品名称" value="{{dishName}}" bindinput="onDishName" placeholder="产品名称" />
    <van-field label="生产者" value="{{brandName}}" bindinput="onBrandName" placeholder="生产者" />
    <van-field label="价格" value="{{price}}" type="number" bindinput="onPrice" placeholder="价格" />
    <van-field label="产品类别" value="{{categorySearch}}" bindinput="onCategorySearch" placeholder="搜索产品类别" />
    <view class="suggestions" wx:if="{{categorySuggestions.length}}">
      <van-tag wx:for="{{categorySuggestions}}" wx:key="*this" data-name="{{item}}" bindtap="pickCategory" style="margin:4px">{{item}}</van-tag>
    </view>
    <view class="chips" wx:if="{{selectedCategory}}">
      <van-tag closeable type="warning" bindtap="removeCategory">{{selectedCategory}}</van-tag>
    </view>
    <view class="field" wx:if="{{flavors.length}}">
      <text class="label">味道</text>
      <view class="wheel-wrap">
        <canvas canvas-id="flavorWheel" id="flavorWheel" class="flavor-canvas" catchtouchstart="onWheelTouch" catchtouchmove="onWheelMove" />
        <van-button size="mini" plain type="primary" bindtap="resetFlavors">重置</van-button>
      </view>
    </view>
    <view class="field" wx:if="{{preferenceOptions.length}}">
      <text class="label">偏好</text>
      <view class="preference-panel">
        <text class="pref-face">{{preferenceFace}}</text>
        <van-slider value="{{prefLevel}}" min="{{preferenceOptions[0].level}}" max="{{preferenceOptions[preferenceOptions.length-1].level}}" bind:change="onPreferenceChange" style="flex:1" />
        <text class="pref-label">{{preferenceLabel}}</text>
      </view>
    </view>
    <van-field wx:if="{{reasonField === 'bad'}}" label="难吃理由" value="{{badlyReason}}" bindinput="onBadlyReason" placeholder="请输入难吃理由" />
    <van-field wx:if="{{reasonField === 'good'}}" label="推荐理由" value="{{goodReason}}" bindinput="onGoodReason" placeholder="请输入推荐理由" />
    <van-field label="原料" value="{{ingredientSearch}}" bindinput="onIngredientSearch" placeholder="搜索原料" />
    <van-field label="含量%" value="{{ingredientAmount}}" type="number" bindinput="onIngredientAmount" placeholder="含量%" />
    <view class="suggestions" wx:if="{{ingredientSuggestions.length}}">
      <van-tag wx:for="{{ingredientSuggestions}}" wx:key="index" data-idx="{{index}}" bindtap="pickIngredient" style="margin:4px">{{item.name}}</van-tag>
    </view>
    <view class="chips">
      <van-tag closeable wx:for="{{ingredients}}" wx:key="index" data-idx="{{index}}" bindtap="removeIngredient" style="margin:4px">{{item.name}}</van-tag>
    </view>
    <view style="margin-top:16px"><van-button type="primary" block bindtap="submit">保存记录</van-button></view>
  </view>

  <view class="records">
    <view class="record-inner" wx:for="{{records}}" wx:key="id">
      <van-cell title="{{item.name}}" value="{{item.brand_name}}" is-link bindtap="toggleDetail" data-id="{{item.id}}" />
      <view wx:if="{{expandedId === item.id}}" class="detail">
        <view wx:if="{{item.reason}}">理由：{{item.reason}}</view>
        <view wx:if="{{item.price}}">价格：{{item.price}}</view>
        <view wx:if="{{item.categories.length}}">类别：{{item.categories}}</view>
        <view wx:if="{{item.pickable}}" class="repurchase-actions">
          <van-button size="mini" type="primary" data-id="{{item.id}}" data-value="{{prefGood}}" bindtap="repurchase">偏好吃</van-button>
          <van-button size="mini" type="danger" data-id="{{item.id}}" data-value="{{prefBad}}" bindtap="repurchase">偏难吃</van-button>
        </view>
      </view>
    </view>
    <view wx:if="{{!records.length && !loading}}"><van-empty description="暂无记录" /></view>
    <view wx:if="{{loading}}"><van-loading /></view>
  </view>
  <view wx:if="{{hasMore && records.length}}" class="loading-hint">上拉加载更多</view>
</view>
