.page { padding: 16px; padding-bottom: 20px; }
.card { background: #fff; margin-bottom: 16px; padding: 4px 0; }
.suggestions { display: flex; flex-wrap: wrap; padding: 4px 16px; }
.chips { display: flex; flex-wrap: wrap; margin: 4px 16px; }
.field { padding: 4px 16px; }
.label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 14px; }
.wheel-wrap { display: flex; flex-direction: column; align-items: center; padding: 8px 0; }
.flavor-canvas { width: 220px; height: 220px; }
.preference-panel { display: flex; align-items: center; gap: 10px; padding: 8px 0; }
.pref-face { font-size: 28px; }
.pref-label { font-size: 14px; min-width: 48px; }
.records { margin-top: 8px; }
.record { background: #fff; border-radius: 12px; margin-bottom: 10px; overflow: hidden; border-left: 5px solid #66508f; }
.record.preference-excellent { border-left-color: #2c9e5f; }
.record.preference-bad { border-left-color: #c0504d; }
.record.preference-good { border-left-color: #66508f; }
.record-main { display: flex; align-items: center; gap: 12px; padding: 12px; }
.record-img { width: 64px; height: 64px; border-radius: 10px; flex-shrink: 0; }
.record-info { flex: 1; }
.record-name { font-weight: 700; font-size: 15px; }
.record-brand { color: #888; font-size: 12px; display: block; margin-top: 2px; }
.record-tags { display: flex; flex-wrap: wrap; margin-top: 4px; }
.repurchase-count { color: #999; font-size: 12px; display: block; margin-top: 4px; }
.detail { padding: 10px 16px; background: #fff; border-top: 1px solid #f0f0f0; }
.detail-block { display: flex; flex-wrap: wrap; align-items: center; margin-top: 4px; }
.detail-head { font-weight: 600; font-size: 13px; margin-right: 4px; }
.repurchase-actions { display: flex; gap: 8px; margin-top: 8px; }
.loading-hint { text-align: center; color: #999; padding: 14px 0; }
