.page { padding: 16px; padding-bottom: 40px; }
.card { background: #fff; border-radius: 16px; padding: 16px; margin-bottom: 16px; box-shadow: 0 2px 10px rgba(0,0,0,.06); }
.field { margin-bottom: 12px; }
.label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 14px; }
input, textarea { border: 1px solid #e5dff0; border-radius: 8px; padding: 12px 10px; font-size: 14px; width: 100%; box-sizing: border-box; min-height: 42px; }
.reason-input { margin-top: 4px; }
.entry-row { display: flex; gap: 8px; }
.entry-row input:first-child { flex: 1; }
.entry-row input:last-child { flex: 0 0 90px; }
.suggestions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.suggest { padding: 6px 10px; background: #f4f0f8; border-radius: 8px; font-size: 13px; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.chip { display: inline-flex; align-items: center; gap: 4px; padding: 5px 8px; background: #d9c7ff; border-radius: 8px; font-size: 13px; }
.chip-x { color: #888; margin-left: 2px; font-size: 16px; }
.save-btn { background: #66508f; color: #fff; border-radius: 10px; font-size: 15px; margin-top: 8px; padding: 12px; }

/* 味道雷达图 */
.wheel-wrap { position: relative; display: flex; align-items: center; justify-content: center; flex-direction: column; }
.flavor-canvas { width: 220px; height: 220px; }
.flavor-reset { margin-top: 4px; color: #66508f; font-size: 13px; padding: 4px 12px; background: #f4f0f8; border-radius: 8px; }

/* 偏好面板 */
.preference-panel { display: flex; align-items: center; gap: 10px; padding: 6px 0; }
.pref-face { font-size: 30px; }
.pref-label { font-size: 14px; color: #333; min-width: 48px; }

/* 记录列表 */
.search-row input { background: #fff; }
.records { margin-top: 8px; }
.record { background: #fff; border-radius: 12px; margin-bottom: 10px; overflow: hidden; border-left: 4px solid #e0e0e0; }
.record.preference-excellent { border-left-color: #2c9e5f; }
.record.preference-bad { border-left-color: #c0504d; }
.record.preference-good { border-left-color: #d9c7ff; }
.record-main { display: flex; align-items: center; gap: 10px; padding: 12px; }
.record-img { width: 64px; height: 64px; border-radius: 10px; flex-shrink: 0; }
.record-info { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 4px; flex: 1; }
.record-name { font-weight: 700; }
.record-brand { color: #888; font-size: 13px; }
.record-tags { display: flex; flex-wrap: wrap; gap: 4px; }
.record-tag { font-size: 11px; background: #f4f0f8; padding: 2px 6px; border-radius: 4px; color: #555; }
.record-meta { color: #999; font-size: 12px; margin-top: 2px; }
.repurchase-actions { display: flex; align-items: center; gap: 8px; padding: 0 12px 12px; flex-wrap: wrap; }
.repurchase-choice { background: #66508f; color: #fff; font-size: 12px; padding: 6px 14px; border-radius: 6px; margin: 0; }
.repurchase-choice.bad { background: #c0504d; }
.repurchase-count { color: #999; font-size: 12px; }
.reason-display { padding: 8px 12px 12px; font-size: 13px; color: #c0504d; }
.reason-display.good { color: #2c9e5f; }
.detail { padding: 8px 12px 12px; border-top: 1px solid #f0f0f0; display: flex; flex-direction: column; gap: 6px; }
.detail-line { font-size: 13px; color: #333; }
.detail-block { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.detail-head { font-size: 13px; font-weight: 600; }
.detail-tag { font-size: 12px; background: #f4f0f8; padding: 3px 8px; border-radius: 6px; }
.load-more { text-align: center; color: #66508f; padding: 12px; }
.image-picker { width: 100%; height: 160px; border: 1px dashed #66508f; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: #f4f0f8; color: #66508f; }
.preview-img { width: 100%; height: 160px; border-radius: 12px; }
.upload-hint { color: #888; font-size: 14px; }
.remove-img { color: #b45d5d; font-size: 13px; margin-top: 4px; display: block; }

.loading-hint { text-align: center; color: #999; font-size: 13px; padding: 14px 0; }
