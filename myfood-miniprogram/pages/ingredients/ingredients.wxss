.page { padding: 16px; }
.add-row { display: flex; gap: 8px; margin-bottom: 12px; }
.add-row input { flex: 1; border: 1px solid #e5dff0; border-radius: 8px; padding: 8px 10px; }
.search { border: 1px solid #e5dff0; border-radius: 8px; padding: 8px 10px; margin-bottom: 12px; width: 100%; box-sizing: border-box; }
.item { padding: 10px; background: #fff; border-radius: 8px; margin-bottom: 6px; }
