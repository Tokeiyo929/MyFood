<view class="page">
  <view class="add-row">
    <van-field value="{{newName}}" bindinput="onNewName" placeholder="添加原料" />
    <view style="margin:8px"><van-button type="primary" size="small" bindtap="addIngredient">添加</van-button></view>
  </view>
  <van-cell-group>
    <van-cell wx:for="{{ingredients}}" wx:key="id" title="{{item.name}}" />
  </van-cell-group>
  <view wx:if="{{!ingredients.length}}" class="empty"><van-empty description="暂无原料" /></view>
</view>
