<view class="page">
  <view class="add-row">
    <input value="{{newName}}" bindinput="onNewName" placeholder="添加原料" />
    <button size="mini" bindtap="addIngredient">添加</button>
  </view>
  <view class="list">
    <view class="item" wx:for="{{ingredients}}" wx:key="id">{{item.name}}</view>
  </view>
</view>
