<view class="page">
  <view class="add-row">
    <van-field value="{{newName}}" bindinput="onNewName" placeholder="添加原料" />
    <view style="margin:8px"><van-button type="primary" size="small" bindtap="addIngredient">添加</van-button></view>
  </view>
  <van-search value="{{search}}" bind:change="onSearch" placeholder="搜索原料" />
  <view class="grid">
    <view class="grid-item" wx:for="{{ingredients}}" wx:key="id">{{item.name}}</view>
  </view>
  <view wx:if="{{!ingredients.length && !loading}}" class="empty"><van-empty description="暂无原料" /></view>
</view>
